+def _channel_compat() -> dict:
+    """渠道能力矩阵（LEO_PPT_PARAM_COMPAT，由 backend_execution 注入）。
+
+    ``rejects``：渠道实测拒收参数（优先于家族规则）；``size``：尺寸档约束
+    （multiples_of/min_edge/max_edge/max_pixels，实测登记，服务端终裁兜底）。
+    缺省/解析失败按无矩阵处理，走家族回退规则。
+    """
+    raw = os.getenv("LEO_PPT_PARAM_COMPAT", "")
+    if not raw.strip():
+        return {}
+    try:
+        value = _json.loads(raw)
+        return value if isinstance(value, dict) else {}
+    except ValueError:
+        return {}
+
+
+def _channel_rejects(param: str) -> bool:
+    rejects = _channel_compat().get("rejects") or []
+    return param in rejects
