{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leo-ppt.invalid/schemas/paired-rebaseline/v1",
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "page_id",
        "lane",
        "theme_family",
        "material",
        "old_selection",
        "old_snapshot",
        "new_request",
        "old_output",
        "new_output",
        "new_fingerprint"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "enum": [
            "render:html",
            "image"
          ]
        },
        "theme_family": {
          "type": "string",
          "minLength": 1
        },
        "material": {
          "$ref": "#/$defs/reference"
        },
        "old_selection": {
          "$ref": "#/$defs/reference"
        },
        "old_snapshot": {
          "$ref": "#/$defs/reference",
          "description": "HTML 为资产快照描述；image 必须引用原 baseline receipt 的 legacy-image-export，包含历史 theme_source。"
        },
        "new_request": {
          "$ref": "#/$defs/reference"
        },
        "old_output": {
          "type": "string",
          "minLength": 1
        },
        "new_output": {
          "type": "string",
          "minLength": 1
        },
        "new_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_digest",
            "source_digest",
            "library_digest",
            "environment"
          ],
          "properties": {
            "request_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "library_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "environment": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "baseline",
    "environment",
    "cases",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "paired-rebaseline-plan"
    },
    "baseline": {
      "$ref": "#/$defs/reference"
    },
    "environment": {
      "type": "object",
      "required": [
        "execution_source_digest"
      ],
      "properties": {
        "execution_source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
