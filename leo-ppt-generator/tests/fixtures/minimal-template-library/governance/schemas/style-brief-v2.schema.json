{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://leo-ppt.invalid/schemas/style-brief/v2",
  "title": "风格 brief（作者真值：身份/适用性/指令/绑定；不拥有精确色板、字体文件、几何、通过状态）",
  "type": "object",
  "required": [
    "schema_version",
    "entity",
    "asset_id",
    "name",
    "lifecycle",
    "taxonomy",
    "visual_language",
    "bindings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "entity": {
      "const": "style-brief"
    },
    "asset_id": {
      "$ref": "https://leo-ppt.invalid/schemas/asset-common/v1#/definitions/asset_id"
    },
    "name": {
      "$ref": "https://leo-ppt.invalid/schemas/asset-common/v1#/definitions/name_zh"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variant_of": {
      "type": [
        "null",
        "string"
      ]
    },
    "lifecycle": {
      "$ref": "https://leo-ppt.invalid/schemas/asset-common/v1#/definitions/lifecycle"
    },
    "source": {
      "type": "object",
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "enum": [
            "authored",
            "intake",
            "user-imported",
            "legacy-migrated"
          ]
        },
        "upstream": {
          "type": "string"
        },
        "license_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "families"
      ],
      "additionalProperties": false,
      "properties": {
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recommendation_features": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "audience_conservatism": {
          "enum": [
            "reserved",
            "balanced",
            "expressive"
          ]
        },
        "formality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "density": {
          "enum": [
            "very-low",
            "low",
            "low-medium",
            "balanced",
            "medium-high",
            "high"
          ]
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "desktop-review",
              "meeting-room-projector",
              "large-venue-screen",
              "bright-large-venue",
              "roadshow-stage",
              "conference-screen",
              "classroom-screen",
              "print"
            ]
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counter_indications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "反例：明确不适用的任务条件"
        }
      }
    },
    "visual_language": {
      "type": "object",
      "required": [
        "direction"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "minLength": 8
        },
        "features": {
          "type": "array",
          "minItems": 2,
          "description": "可观察构图/排印/材质特征，至少两条；active 必填（语义门）"
        },
        "composition_discipline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "continuity": {
          "type": "object",
          "description": "封面/正文/数据/结尾各角色纪律"
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "negative": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 4
          },
          "description": "负面约束：针对真实失败、可观察；不凑模板话术"
        },
        "hard_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "稳定约束 ID 引用（governance/rules）"
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "theme_default": {
          "type": [
            "null",
            "string"
          ],
          "description": "active 必填（语义门）；draft 可缺（adaptation_gaps 记录）"
        },
        "modes_supported": {
          "type": "array",
          "items": {
            "$ref": "https://leo-ppt.invalid/schemas/asset-common/v1#/definitions/mode"
          }
        },
        "layout_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "page_type",
              "preferred"
            ],
            "properties": {
              "page_type": {
                "type": "string"
              },
              "preferred": {
                "type": "array",
                "items": {
                  "$ref": "https://leo-ppt.invalid/schemas/asset-common/v1#/definitions/asset_ref"
                }
              },
              "discouraged": {
                "type": "array",
                "items": {
                  "$ref": "https://leo-ppt.invalid/schemas/asset-common/v1#/definitions/asset_ref"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "capacity_factor": {
          "type": "object",
          "description": "迁移保留的容量折减视图；容量真值归实际 layout profile"
        }
      }
    },
    "adaptation_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "draft/reference 的明确缺口；不允许猜值凑完成率"
    },
    "content_review": {
      "type": "object",
      "required": [
        "reviewed"
      ],
      "properties": {
        "reviewed": {
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "keep",
            "revise",
            "merged",
            "draft",
            "reference"
          ]
        },
        "reviewer_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "legacy_payload": {
      "type": "object",
      "description": "机械迁移保留的旧 brief 原始字段（color_palette/typography/layout_patterns 等）；仅作 U3 审阅来源，不是新真值"
    }
  },
  "description": "风格 brief v2。draft 允许缺 theme_default/features/推荐特征（机械迁移不凑字段）；lifecycle=active 的语义完整性由治理 lint/U2 强制。"
}
