      "mode": "light",
      "density": [
        "balanced",
        "low-medium"
      ],
      "checks": {
        "overflow": "hard",
        "contrast_text_min": 4.5,
        "contrast_large_min": 3.0,
        "blank_bytes_min": 40000,
        "blank_bytes_warn": 80000,
        "min_width": 2560,
        "aspect": "16:9"
      }
    },
    "html-dark-balanced": {
      "lane": "html",
      "mode": "dark",
      "density": [
        "balanced",
        "low-medium"
      ],
      "checks": {
        "overflow": "hard",
        "contrast_text_min": 4.5,
        "contrast_large_min": 3.0,
        "blank_bytes_min": 40000,
        "blank_bytes_warn": 80000,
        "min_width": 2560,
        "aspect": "16:9"
      }
    },
    "html-light-dense": {
      "lane": "html",
      "mode": "light",
      "density": [
        "medium-high",
        "high"
      ],
      "checks": {
        "overflow": "hard",
        "contrast_text_min": 4.5,
        "contrast_large_min": 3.0,
        "blank_bytes_min": 40000,
        "blank_bytes_warn": 80000,
        "min_width": 2560,
        "aspect": "16:9"
      }
