{
  "schema_version": 1,
  "entity": "render-template",
  "asset_id": "builtin:template:table-pro",
  "name": "table-pro",
  "lane": "render:html",
  "input_fields": [
    {
      "name": "kicker",
      "required": false,
      "type": "string",
      "maxLength": 60
    },
    {
      "name": "title",
      "required": true,
      "type": "string",
      "maxLength": 24
    },
    {
      "name": "columns",
      "required": true,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 18
      },
      "count_min": 2,
      "count_max": 5
    },
    {
      "name": "rows",
      "required": true,
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 48
        },
        "minItems": 2,
        "maxItems": 5
      },
      "count_min": 1,
      "count_max": 6
    },
    {
      "name": "footnote",
      "required": false,
      "type": "string",
      "maxLength": 90
    },
    {
      "name": "page_no",
      "required": false,
      "type": "integer"
    }
  ],
  "slot_bindings": [
    {
      "slot": "columns",
      "selector": "[data-leo-block='thead']",
      "binding_kind": "structural"
    },
    {
      "slot": "rows",
      "selector": "[data-leo-block='tbody']",
      "binding_kind": "structural"
    },
    {
      "slot": "table",
      "selector": "[data-leo-block='table']",
      "binding_kind": "structural"
    },
    {
      "slot": "kicker",
      "selector": "[data-leo-block='kicker']",
      "binding_kind": "structural"
    },
    {
      "slot": "title",
      "selector": "[data-leo-block='title']",
      "binding_kind": "structural"
    },
    {
      "slot": "footnote",
      "selector": "[data-leo-block='footnote']",
      "binding_kind": "structural"
    },
    {
      "slot": "page_no",
      "selector": "[data-leo-block='page-no']",
      "binding_kind": "structural"
    }
  ],
  "theme_roles": [
    "primary",
    "accent",
    "background",
    "surface",
    "text",
    "muted",
    "border",
    "on_primary"
  ],
  "layout_profiles": [
    "builtin:layout:p21-21-tech-spec-sheet-layouts"
  ],
  "dependencies": [
    "builtin:layout:p21-21-tech-spec-sheet-layouts"
  ],
  "notes": "输入对象形状、数量与 layout 槽位一致；字号来自 effective_theme，几何来自 layout profile。"
}
