+def _validate_channel_size(size: str) -> bool:
+    """渠道矩阵尺寸约束（实测登记）：违反即清晰报错；未登记返回 False 走回退。"""
+    parsed = _parse_size(size)
+    if parsed is None:
+        return False
+    width, height = parsed
+    constraints = _channel_compat().get("size") or {}
+    if not constraints:
+        return False
+    problems = []
+    multiples = constraints.get("multiples_of")
+    if isinstance(multiples, int) and (width % multiples or height % multiples):
+        problems.append(f"both edges must be multiples of {multiples}px")
+    min_edge = constraints.get("min_edge")
+    if isinstance(min_edge, int) and min(width, height) < min_edge:
+        problems.append(f"each edge must be >= {min_edge}px")
+    max_edge = constraints.get("max_edge")
+    if isinstance(max_edge, int) and max(width, height) > max_edge:
+        problems.append(f"each edge must be <= {max_edge}px")
+    max_pixels = constraints.get("max_pixels")
+    if isinstance(max_pixels, int) and width * height > max_pixels:
+        problems.append(f"total pixels must be <= {max_pixels}")
+    if problems:
+        _die(
+            "channel size menu violated: " + "; ".join(problems)
+            + f" (requested {size}; constraints {_channel_compat()['size']})"
+        )
+    return True
+
