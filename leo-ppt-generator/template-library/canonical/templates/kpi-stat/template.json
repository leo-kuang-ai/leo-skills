{
  "schema_version": 1,
  "entity": "render-template",
  "asset_id": "builtin:template:kpi-stat",
  "name": "kpi-stat",
  "lane": "render:html",
  "input_fields": [
    {
      "name": "kicker",
      "required": false,
      "type": "string",
      "maxLength": 60
    },
    {
      "name": "title",
      "required": true,
      "type": "string",
      "maxLength": 24
    },
    {
      "name": "kpis",
      "required": true,
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 14
          },
          "value": {
            "type": "string",
            "maxLength": 12,
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "maxLength": 6
          },
          "before": {
            "type": "string",
            "maxLength": 26
          }
        },
        "required": [
          "label",
          "value"
        ]
      },
      "count_min": 2,
      "count_max": 4
    },
    {
      "name": "chart_title",
      "required": false,
      "type": "string",
      "maxLength": 40
    },
    {
      "name": "chart_svg",
      "required": false,
      "type": "string"
    },
    {
      "name": "dual",
      "required": false,
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "direct",
              "net"
            ],
            "type": "string"
          },
          "tag": {
            "type": "string",
            "maxLength": 18
          },
          "hkd": {
            "type": "string",
            "maxLength": 28
          },
          "usd": {
            "type": "string",
            "maxLength": 48
          }
        },
        "required": [
          "kind",
          "tag",
          "hkd"
        ]
      },
      "count_min": 0,
      "count_max": 2
    },
    {
      "name": "footnote",
      "required": false,
      "type": "string",
      "maxLength": 90
    },
    {
      "name": "page_no",
      "required": false,
      "type": "integer"
    }
  ],
  "slot_bindings": [
    {
      "slot": "kicker",
      "selector": "[data-leo-block='kicker']",
      "binding_kind": "structural"
    },
    {
      "slot": "title",
      "selector": "[data-leo-block='title']",
      "binding_kind": "structural"
    },
    {
      "slot": "kpis",
      "selector": "[data-leo-block='kpis']",
      "binding_kind": "structural"
    },
    {
      "slot": "chart_title",
      "selector": "[data-leo-block='chart_title']",
      "binding_kind": "structural"
    },
    {
      "slot": "chart_svg",
      "selector": "[data-leo-block='chart']",
      "binding_kind": "structural"
    },
    {
      "slot": "dual",
      "selector": "[data-leo-block='dual']",
      "binding_kind": "structural"
    },
    {
      "slot": "footnote",
      "selector": "[data-leo-block='footnote']",
      "binding_kind": "structural"
    },
    {
      "slot": "page_no",
      "selector": "[data-leo-block='page-no']",
      "binding_kind": "structural"
    }
  ],
  "theme_roles": [
    "primary",
    "accent",
    "background",
    "surface",
    "text",
    "muted",
    "border",
    "on_primary"
  ],
  "layout_profiles": [
    "builtin:layout:p20-20-stacked-kpi-ledger-layouts"
  ],
  "dependencies": [
    "builtin:layout:p20-20-stacked-kpi-ledger-layouts"
  ],
  "notes": "输入对象形状、数量与 layout 槽位一致；字号来自 effective_theme，几何来自 layout profile。"
}
