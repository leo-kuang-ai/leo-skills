{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://leo-ppt.invalid/schemas/asset-common/v1",
  "title": "共享身份片段（$ref 消费，不单独实例化）",
  "definitions": {
    "asset_id": {
      "type": "string",
      "pattern": "^(builtin|user):(style|theme|layout|template|component|axis|brand|preset|font|ornament|qa-profile):[A-Za-z0-9\\-\\u4e00-\\u9fff]+$"
    },
    "asset_ref": {
      "type": "string",
      "pattern": "^(builtin|user):(style|theme|layout|template|component|axis|brand|preset|font|ornament|qa-profile):[A-Za-z0-9\\-\\u4e00-\\u9fff]+$"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "name_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9\\-\\u4e00-\\u9fff]+$"
    },
    "mode": {
      "enum": [
        "light",
        "dark"
      ]
    }
  }
}
