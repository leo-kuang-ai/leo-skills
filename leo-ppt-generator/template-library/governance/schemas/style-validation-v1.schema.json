{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://leo-ppt.invalid/schemas/style-validation/v1",
  "title": "验证包 manifest（evidence/<validation-id>/manifest.json）",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "validation_id",
    "assets",
    "lane",
    "result",
    "checks",
    "review",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "style-validation"
    },
    "schema_version": {
      "const": 1
    },
    "validation_id": {
      "type": "string",
      "pattern": "^[0-9a-z\\-]+$"
    },
    "assets": {
      "type": "object",
      "description": "资产 ID/revision（style/theme/layout/template/font）",
      "additionalProperties": {
        "type": [
          "null",
          "string"
        ]
      }
    },
    "dependencies_digest": {
      "type": "string"
    },
    "lane": {
      "enum": [
        "image",
        "html"
      ]
    },
    "mode": {
      "type": [
        "null",
        "string"
      ]
    },
    "locale": {
      "type": [
        "null",
        "string"
      ]
    },
    "page_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixture": {
      "type": [
        "null",
        "string"
      ]
    },
    "backend": {
      "type": [
        "null",
        "string"
      ]
    },
    "model": {
      "type": [
        "null",
        "string"
      ]
    },
    "compiler": {
      "type": "object"
    },
    "checks_profile": {
      "type": [
        "null",
        "string"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not-applicable"
            ]
          },
          "detail": {
            "type": "string"
          },
          "not_applicable_basis": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "source",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "model",
            "human"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "rubric": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "run_ref": {
      "type": [
        "null",
        "string"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
