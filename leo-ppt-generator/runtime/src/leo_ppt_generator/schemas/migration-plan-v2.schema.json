{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leo-ppt.invalid/schemas/migration-plan/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "phase", "gate", "source_root", "base_revision", "dirty_snapshot", "source_snapshot", "closure", "mapping", "target_hashes", "delete_allowlist", "allowlist_digest", "prerequisite", "gaps", "owner_sha256", "plan_digest"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "template-library-migration-plan"},
    "phase": {"const": "preview"},
    "gate": {"enum": ["U7-A", "U7-B"]},
    "source_root": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty_snapshot": {"type": "object", "additionalProperties": {"type": "object"}},
    "source_snapshot": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/state"}},
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["roots", "signatures", "hits", "unclassified_hits", "active_legacy_hits"],
      "properties": {
        "roots": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"type": "object", "required": ["path", "exists"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "exists": {"type": "boolean"}}}},
        "signatures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hits": {"type": "array", "items": {"$ref": "#/$defs/hit"}},
        "unclassified_hits": {"const": 0},
        "active_legacy_hits": {"type": "integer", "minimum": 0}
      }
    },
    "mapping": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/mapping"}},
    "target_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "delete_allowlist": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected", "after_publish", "already_absent"],
      "properties": {"path": {"type": "string"}, "expected": {"$ref": "#/$defs/state"}, "after_publish": {"$ref": "#/$defs/state"}, "already_absent": {"const": "only-after-journaled-delete"}}
    }},
    "allowlist_digest": {"$ref": "#/$defs/hash"},
    "prerequisite": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owner_sha256": {"$ref": "#/$defs/hash"},
    "plan_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "state": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "sha256", "mode"], "properties": {"type": {"const": "file"}, "sha256": {"$ref": "#/$defs/hash"}, "mode": {"type": "integer", "minimum": 0, "maximum": 511}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "sha256", "mode"], "properties": {"type": {"const": "absent"}, "sha256": {"type": "null"}, "mode": {"type": "null"}}}
      ]
    },
    "mapping": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["operation", "source", "sha256", "mode"], "properties": {"operation": {"enum": ["copy", "normalize"]}, "source": {"type": "string", "minLength": 1}, "source_relative_to_library": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "mode": {"type": "integer", "minimum": 0, "maximum": 511}}},
        {"type": "object", "additionalProperties": false, "required": ["operation", "payload", "sha256", "mode"], "properties": {"operation": {"const": "derived"}, "payload": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "mode": {"type": "integer", "minimum": 0, "maximum": 511}}}
      ]
    },
    "hit": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line", "signature", "classification", "owner", "disposition"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1},
        "signature": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1},
        "classification": {"enum": ["active-consumer", "migration-input", "test-fixture", "plan-control", "provenance", "generated-excluded", "delete"]},
        "disposition": {"type": "string", "minLength": 1}
      }
    }
  }
}
