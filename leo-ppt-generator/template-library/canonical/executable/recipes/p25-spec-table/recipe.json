{
  "schema_version": 1,
  "entity": "image-recipe",
  "asset_id": "builtin:recipe:p25-spec-table",
  "name": "规格参数表图片页",
  "version": 1,
  "lane": "image",
  "layout_profiles": [
    "builtin:layout:p25-spec-table"
  ],
  "slot_map": {
    "rows": {
      "content_type": "table",
      "projection": "structures",
      "input_path": "rows"
    },
    "columns": {
      "content_type": "table",
      "projection": "structures",
      "input_path": "columns"
    },
    "cell": {
      "content_type": "text",
      "projection": "structures",
      "input_path": "rows.*.*"
    }
  },
  "canvas": {
    "width": 2560,
    "height": 1440
  },
  "provider": {
    "adapter": "openai-compatible",
    "capability": "generate"
  },
  "required_data_projection": [
    "claim",
    "items",
    "structures",
    "expression",
    "numbers",
    "required_text"
  ],
  "prompt_skeleton": "生成一张管理层演示页，16:9。以严格对齐的规格表表达比较或趋势，保留所有事实、单位、未知值和口径；禁止重排行列或补写数据。\n正文与事实：{content}\n表达合同：{expression}\n统一主题：{theme}\n结构与槽位：{layout}",
  "probe_evidence_ref": "evidence/capability-receipts.json"
}
