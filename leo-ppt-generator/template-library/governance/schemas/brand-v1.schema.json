{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://leo-ppt.invalid/schemas/brand/v1",
  "title": "品牌身份（保留核验状态，不冒称官方 VI）",
  "type": "object",
  "required": [
    "schema_version",
    "entity",
    "asset_id",
    "name",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entity": {
      "const": "brand-identity"
    },
    "asset_id": {
      "$ref": "https://leo-ppt.invalid/schemas/asset-common/v1#/definitions/asset_id"
    },
    "name": {
      "$ref": "https://leo-ppt.invalid/schemas/asset-common/v1#/definitions/name_zh"
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "typography": {
      "type": "string"
    },
    "tone": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "verified_at": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "locked_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "品牌锁定角色；任务覆盖不得改"
    }
  }
}
